hostname ix_bgp_b
!
ip prefix-list pl-lo 1 permit 10.0.0.1/32
!
route-map from-a permit 10
  match ip address prefix-list pl-lo
  set local-preference 200
!
route-map from-a permit 20
!
router bgp 65002
  router-id 10.255.0.2
  default-local-preference 99
  neighbor 192.168.0.1 remote-as 65001
  address-family ipv4 unicast
    neighbor 192.168.0.1 route-map from-a in
!
interface GigaEthernet0.0
  ip address 192.168.0.0/31
  no shutdown
!
