!Version ArubaOS-CX FL.10.13.1040
hostname AOSCX-ROUTER
ip prefix-list INTERNAL seq 10 permit 10.0.0.0/8 ge 16 le 24
route-map FROM-CORE permit seq 10
    match ip address prefix-list INTERNAL
    set local-preference 200
route-map FROM-CORE deny seq 20
route-map TO-CORE permit seq 10
router bgp 65000
    bgp router-id 192.0.2.41
    neighbor 10.255.1.1 remote-as 65001
    address-family ipv4 unicast
        neighbor 10.255.1.1 activate
        neighbor 10.255.1.1 route-map FROM-CORE in
        neighbor 10.255.1.1 route-map TO-CORE out
