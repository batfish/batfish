config global
    config system global
        set hostname "static_routes_vdom_warnings"
    end
    config system interface
        edit "port1"
            set vdom "root"
            set ip 192.168.1.1 255.255.255.0
            set type physical
        next
        edit "mesh1"
            set vdom "root"
            set type wl-mesh
        next
    end
end

config vdom
    edit root
        config wanopt
            edit 1
                set mode manual
            next
        end
        config firewall address
            edit "vdom_addr"
                set subnet 192.0.2.0 255.255.255.0
            next
        end
        config router static
            edit 1
                set dst 10.0.0.0 255.0.0.0
                set gateway 192.168.1.254
                set device "port1"
            next
            edit 2
                set dst 10.1.0.0 255.255.0.0
                set device "mesh1"
            next
        end
    next
    edit ""
        config router static
            edit 1
                set dst 198.51.100.0 255.255.255.0
                set device "port1"
            next
        end
    next
end
