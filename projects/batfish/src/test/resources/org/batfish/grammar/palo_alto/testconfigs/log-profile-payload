config {
  shared {
    log-settings {
      http {
        webhook-profile {
          format {
            system {
              payload "{
  "attachments": [
    {
      "fallback": "$device_name reports $severity",
      "color": "danger",
      "text": "*Time:* $time_generated"
    }
  ]
}";
            }
          }
        }
      }
    }
  }
  devices {
    localhost.localdomain {
      deviceconfig {
        system {
          hostname log-profile-payload;
        }
      }
      network {
        interface {
          ethernet {
            ethernet1/1 {
              layer3 {
                ip {
                  10.0.1.1/24;
                }
              }
            }
          }
        }
        virtual-router {
          default {
            interface [ ethernet1/1 ];
          }
        }
      }
    }
  }
}
