#RANCID-CONTENT-TYPE: paloalto
deviceconfig {
  system {
    hostname logical-router-bgp;
  }
}
network {
  interface {
    ethernet {
      ethernet1/1 {
        layer3 {
          ip {
            10.0.1.1/24;
          }
        }
      }
    }
  }
  logical-router {
    LR1 {
      vrf {
        default {
          interface [ ethernet1/1 ];
          bgp {
            enable yes;
            router-id 10.0.1.1;
            local-as 65001;
            peer-group {
              PG1 {
                enable yes;
                type {
                  ebgp;
                }
                peer {
                  PEER1 {
                    enable yes;
                    peer-as 65002;
                    local-address {
                      interface ethernet1/1;
                      ip 10.0.1.1/24;
                    }
                    peer-address {
                      ip 10.0.1.2;
                    }
                    connection-options {
                      multihop 2;
                    }
                    inherit {
                      yes;
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
vsys {
  vsys1 {
    import {
      network {
        interface [ ethernet1/1 ];
        logical-router [ LR1 ];
      }
    }
  }
}
