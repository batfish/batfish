#RANCID-CONTENT-TYPE: paloalto
deviceconfig {
  system {
    hostname logical-router-engine-on;
  }
  setting {
    advance-routing yes;
    ctd {
      tcp-bypass-exceed-queue no;
    }
  }
}
network {
  interface {
    ethernet {
      ethernet1/1 {
        layer3 {
          ip {
            10.0.1.1/24;
          }
        }
      }
    }
  }
  logical-router {
    LR1 {
      vrf {
        default {
          interface [ ethernet1/1 ];
          bgp {
            enable yes;
            router-id 10.0.1.1;
            local-as 65001;
          }
        }
      }
    }
  }
  virtual-router {
    default {
      protocol {
        bgp {
          enable no;
        }
      }
    }
  }
}
