
# vdom creation at the top of the file
config vdom
edit root
next
edit primary
next
edit software-factory
next
end

config global
    config system interface
        edit port1
            set vdom primary
            set type physical
        next
        edit port2
            set vdom software-factory
            set type physical
        next
    end
end

config vdom
    edit primary
        config router static
            edit 1
                set device port1
                set gateway 192.168.1.254
                set dst 10.0.0.0 255.0.0.0
            next
        end
    end
    edit software-factory
        config router bgp
            set as 65001
        end
        config router ospf
            # The nested end closes only the redistribution block.
            config redistribute "connected"
                set status enable
            end
        end
        config router static
            edit 1
                set device port2
                set gateway 10.0.0.254
                set dst 192.168.1.0 255.255.255.0
            next
        end
    end
end

config system global
    set hostname "static_routes_vdom_end"
end
