set system host-name mac-vrf
set interfaces irb unit 10 family inet address 192.0.2.1/24
set routing-instances EVPN instance-type mac-vrf
set routing-instances EVPN service-type vlan-aware
set routing-instances EVPN vlans USERS description "User VLAN"
set routing-instances EVPN vlans USERS l3-interface irb.10
set routing-instances EVPN vlans USERS vlan-id 10
set routing-instances EVPN vlans USERS vxlan vni 10010
set routing-instances EVPN vlans USERS forwarding-options dhcp-security option-82 circuit-id
set routing-instances EVPN-VLAN instance-type mac-vrf
set routing-instances EVPN-VLAN service-type vlan-based
set routing-instances EVPN-BUNDLE instance-type mac-vrf
set routing-instances EVPN-BUNDLE service-type vlan-bundle
