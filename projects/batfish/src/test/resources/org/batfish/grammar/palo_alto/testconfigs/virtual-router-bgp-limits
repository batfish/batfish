#RANCID-CONTENT-TYPE: paloalto
deviceconfig {
  system {
    hostname virtual-router-bgp-limits;
  }
}
network {
  interface {
    ethernet {
      ethernet1/1 {
        layer3 {
          ip {
            10.0.1.1/24;
          }
        }
      }
    }
  }
  virtual-router {
    VR1 {
      interface [ ethernet1/1 ];
      protocol {
        bgp {
          enable yes;
          router-id 10.0.1.1;
          local-as 4200000001;
          peer-group {
            PG1 {
              enable yes;
              type {
                ebgp;
              }
              peer {
                peer-xxxxxxxxxxxxxxxxxxxxxxxxxxx {
                  enable yes;
                  peer-as 65002;
                  local-address {
                    ip 10.0.1.1/24;
                  }
                  peer-address {
                    ip 10.0.1.2;
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
