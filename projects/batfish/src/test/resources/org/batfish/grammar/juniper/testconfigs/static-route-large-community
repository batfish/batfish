set system host-name static-route-large-community
set interfaces lo0 unit 0 family inet address 192.0.2.1/32
set routing-options autonomous-system 64512
set routing-options static route 192.0.2.0/24 discard
set routing-options static route 192.0.2.0/24 community large:64512:1:2
set policy-options policy-statement EXPORT term STATIC from protocol static
