#RANCID-CONTENT-TYPE: paloalto
deviceconfig {
  system {
    hostname logical-router-nondefault-vrf;
  }
}
network {
  interface {
    ethernet {
      ethernet1/1 {
        layer3 {
          ip {
            10.0.1.1/24;
          }
        }
      }
    }
  }
  logical-router {
    LR1 {
      vrf {
        tenantA {
          interface [ ethernet1/1 ];
          bgp {
            enable yes;
            router-id 10.0.1.1;
            local-as 65001;
          }
        }
      }
    }
  }
}
