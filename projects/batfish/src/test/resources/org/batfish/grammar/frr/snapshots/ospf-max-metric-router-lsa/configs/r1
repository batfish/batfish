r1
# This file describes the network interfaces
auto lo
iface lo inet loopback

auto swp1
iface swp1

auto swp2
iface swp2

# ports.conf --
frr version
frr defaults datacenter
!
ip route 192.0.2.0/24 blackhole
!
interface lo
 ip address 10.255.1.1/32
 ip ospf area 1
!
interface swp1
 ip address 10.11.0.1/31
 ip ospf area 1
 ip ospf network point-to-point
!
interface swp2
 ip address 10.12.0.1/31
 ip ospf area 1
 ip ospf network point-to-point
 ip ospf cost 40000
!
route-map STATIC-E1 permit 10
 set metric-type type-1
 set metric 20
!
router ospf
 ospf router-id 10.255.1.1
 redistribute static route-map STATIC-E1
!
end
