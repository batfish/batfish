set system host-name r1
set interfaces eth1 unit 0 family inet address 10.1.0.1/24
set interfaces eth2 unit 0 family inet address 10.0.0.1/30
set interfaces lo0 unit 0 family inet address 1.1.1.1/32
set routing-options router-id 1.1.1.1
set routing-options autonomous-system 65001
set policy-options policy-statement export-site term site-a from protocol direct
set policy-options policy-statement export-site term site-a from route-filter 10.1.0.0/24 exact
set policy-options policy-statement export-site term site-a then accept
set protocols bgp group ebgp type external
set protocols bgp group ebgp peer-as 65002
set protocols bgp group ebgp export export-site
set protocols bgp group ebgp neighbor 10.0.0.2
